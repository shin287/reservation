<div class="container justify-content-between align-items-center py-3">

  <h1>マイページ</h1>
  <% if notice %>
    <p><%= notice %></p>
  <% end %>

  <% if @user.avatar.attached? %>
    <%= image_tag @user.avatar, size: "100x100", class: "me-2 rounded-circle"  %>
  <% else %>
    <%= image_tag "default.png", size: "100x100", class: "me-2 rounded-circle" %>
  <% end %>

  <p>名前： <%= @user.name %></p>
  <p>メールアドレス： <%= @user.email %></p>
  <p>パスワード： ********</p>
  <p>自己紹介： <%= @user.introduction %></p>
  <br>

  <% if @user.rooms.exists? %>
    <p><%= link_to "自分の施設一覧へ", my_rooms_path %></p>
  <% end %>
  <p><%= link_to "アカウント編集", edit_user_path(@user) %></p>
  <p><%= link_to "プロフィール編集", edit_profile_path %></p>
  <%= link_to "施設を登録", new_room_path %>


  <h2 id="reservation-index">予約一覧</h2>

  <% @reservations.each do |reservation| %>
    <hr>
    <% if reservation.room.image.attached? %>
      <%= image_tag reservation.room.image, size: "150x100" %>
    <% else %>
      <%= image_tag "default.png", size: "150x100" %>
    <% end %>

    <p>施設名： <%= reservation.room.name %></p>
    <p>紹介文： <%= reservation.room.introduction %></p>
    <p>合計料金： <%= number_with_delimiter(reservation.total_price) %>円</p>
    <p>チェックイン： <%= reservation.check_in %></p>
    <p>チェックアウト： <%= reservation.check_out %></p>
    <p>予約確定日時： <%= reservation.created_at.strftime("%Y/%m/%d %H:%M") %></p>
  <% end %>
</div>