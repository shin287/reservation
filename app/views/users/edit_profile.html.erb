<div class="container mt-4">
  <h1>プロフィール編集</h1>

  <% if @user.errors.any? %>
    <ul>
      <%= @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with model: @user, url: profile_path, local: true, method: :patch do |f| %>
    <div>
      <%= f.label :avatar, "アイコン画像" %><br>
      <%= f.file_field :avatar %>
    </div>

    <div>
      <%= f.label :name, "名前" %><br>
      <%= f.text_field :name %>
    </div>
    
    <div>
      <%= f.label :introduction, "自己紹介" %><br>
      <%= f.text_area :introduction %>
    </div>
    <br>
    <div>
      <%= f.submit "更新する" %>
    </div>
  <% end %>
    <br>
    <p><%= link_to "マイページへ戻る", user_path(@user) %></p>
</div>
