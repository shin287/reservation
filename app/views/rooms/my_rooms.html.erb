<div class="container mt-4">
  <h1>登録施設一覧</h1>

  <% if notice %>
    <p><%= notice %></p>
  <% end %>

  <div class="row">
    <% @rooms.each do |room| %>
      <div class="col-md-4 mb-4">
        <div class="card">
          <% if room.image.attached? %>
            <%= image_tag room.image, size: "200x150" %>
          <% else %>
            <%= image_tag "room_default.png", size: "200x150" %>
          <% end %>
          
          <div class="card-body">
            <h5 class="card-title">
              <%= link_to room.name, room_path(room) %>
            </h5>

            <p class="card-text">紹介文：<%= room.introduction %></p>
            <p class="card-text">料金：<%= number_with_delimiter(room.price) %>円/日</p>
            <p class="card-text">作成日：<%= room.created_at.strftime("%Y/%m/%d") %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <hr>

  <p>合計件数： <%= @rooms.count %>件</p>

  <%= link_to "マイページへ戻る", user_path(current_user) %>
  <%= link_to "施設を登録", new_room_path %>
</div>
