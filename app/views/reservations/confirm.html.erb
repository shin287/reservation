<div class="container mt-4">
  <h1>予約確認</h1>

  <p>施設名： <%= @room.name %></p>
  <p>チェックイン日： <%= @reservation.check_in.strftime("%Y/%m/%d") %></p>
  <p>チェックアウト日： <%= @reservation.check_out.strftime("%Y/%m/%d") %></p>
  <p>宿泊日数： <%= @nights %>泊</p>
  <p>人数： <%= @reservation.people %>人</p>
  <p>お支払い金額： <%= number_with_delimiter(@total_price) %>円</p>

  <%= form_with model:[@room,@reservation], local: true do |f| %>
    <%= f.hidden_field :check_in, value: @reservation.check_in %>
    <%= f.hidden_field :check_out, value: @reservation.check_out %>
    <%= f.hidden_field :people, value: @reservation.people %>

    <%= f.submit "この内容で予約する" %>
  <% end %>

  <div class="mt-3">
    <%= link_to "入力画面に戻る", new_room_reservation_path(@room) %>
  </div>
</div>
