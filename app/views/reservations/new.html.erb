<div class="container mt-4">
  <h1>施設予約</h1>

  <p>施設名： <%= @room.name %></p>
  <p>紹介文： <%= @room.introduction %></p>
  <p>料金： <%= number_with_delimiter(@room.price) %>円/日</p>

  <% if @reservation.errors.any? %>
    <ul>
      <% @reservation.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with model: [@room, @reservation] do |f| %>
    <p class="p">チェックイン</p>
    <%= f.date_field :check_in %>

    <p class="p">チェックアウト</p>
    <%= f.date_field :check_out %>

    <p class="p">人数</p>
    <%= f.number_field :people %>

    <br>
    <br>
    <%= f.submit "予約する" %>
  <% end %>
</div>
